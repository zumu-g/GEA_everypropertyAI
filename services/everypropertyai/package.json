{
  "name": "everypropertyai",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server + CLI exposing PropertyIQ property data to GEA's CMA and proposal tools.",
  "type": "module",
  "bin": {
    "everypropertyai": "dist/cli.js"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "build": "tsc -p tsconfig.json",
    "start:mcp": "node dist/mcp.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
