# ─── Required ────────────────────────────────────────────────────────────────

# Firecrawl — web scraping for unprotected sources (Homely, OldListings, agencies, etc.)
# Get key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# Apify — web scraping for anti-bot-protected portals (REA, Domain, view.com.au)
# Uses dedicated AU real estate actors that bypass Cloudflare + DataDome
# Get token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ─── LLM Extraction (pick one) ──────────────────────────────────────────────

# Option 1: OpenRouter (recommended — cheap, 300+ models)
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model choices:
#   moonshotai/kimi-k2              — Kimi K2 (~$0.60/M tokens, good at extraction)
#   deepseek/deepseek-chat-v3-0324  — DeepSeek V3 (~$0.27/M tokens)
#   google/gemini-2.5-flash         — Gemini Flash (~$0.15/M tokens, fastest)
#   meta-llama/llama-4-maverick     — Llama 4 (~$0.50/M tokens)
#   anthropic/claude-sonnet-4       — Claude via OpenRouter (~$3/M tokens)
OPENROUTER_MODEL=moonshotai/kimi-k2

# Option 2: Direct Anthropic (more expensive, best quality)
ANTHROPIC_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Supabase — persistent database (app works without, uses in-memory cache)
# Get values at: https://supabase.com/dashboard/project/<your-project>/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL      — project URL  (safe to expose in browser)
# NEXT_PUBLIC_SUPABASE_ANON_KEY — anon/public key (safe to expose in browser)
# SUPABASE_SERVICE_ROLE_KEY     — service-role key (SERVER ONLY — never expose)
#
# To activate: paste src/lib/db/schema.sql into the Supabase SQL Editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — preferred provider for address autocomplete (/api/search) and
# forward geocoding (lat/lng). A public "pk." token is fine here; restrict it by
# URL in the Mapbox dashboard. Note: standard plan is "temporary" geocoding —
# don't persist results long-term (use G-NAF for the stored address DB).
MAPBOX_ACCESS_TOKEN=

# Google Maps — address autocomplete fallback when MAPBOX_ACCESS_TOKEN is unset.
# NOTE: api/search reads GOOGLE_PLACES_API_KEY (server-side), not this public var.
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cron — auth token for /api/cron/* routes (optional in dev, required in prod)
# Pass as: Authorization: Bearer <CRON_SECRET>  or  X-Cron-Secret: <CRON_SECRET>
CRON_SECRET=

# API keys — required by EXTERNAL callers of the public data routes (sold-sales,
# on-market-listings, comparable-sales, enrich, property, search, etc.). The
# PropertyIQ website's own same-origin browser calls are exempt. Comma-separated
# (one per consumer, e.g. GEA_HR_recruitAI). Unset = auth disabled (dev only).
# Consumers send: Authorization: Bearer <key>  (or  x-api-key: <key>)
# Per-consumer keys, append-only (convention: epai_<consumer>_<random>). Append a
# new consumer's key — never overwrite the whole list (that revokes everyone).
# e.g. EVERYPROPERTY_API_KEYS=epai_cma_REDACTED,epai_wcv_REDACTED,epai_crm_REDACTED
# See INTEGRATIONS.md → "API keys (per-consumer, append-only)".
EVERYPROPERTY_API_KEYS=
# Consumer side (e.g. the everypropertyai CLI / another app): the key it sends.
# Must equal ONE value in the server's EVERYPROPERTY_API_KEYS above.
# EVERYPROPERTY_API_TOKEN=

# Stealth scraper — separate Camoufox/Patchright browser service for Kasada-
# protected sites (e.g. property.com.au, ratemyagent). The app works WITHOUT it:
# sources with fetchBackend:'stealth' simply fail soft when this is unset, and
# every other source is unaffected. Cannot run on Vercel — deploy the container
# in services/scraper/ (see its README) and point this at it.
STEALTH_SCRAPER_URL=
STEALTH_SCRAPER_SECRET=

# Bright Data Web Unlocker — managed anti-bot fetch (handles Domain's PerimeterX).
# Primary fetch backend for the daily Casey/Cardinia feeds. Create a Web Unlocker
# zone in the Bright Data dashboard; the token is the account API token. Backend
# fails soft when unset (callers fall back to another source).
BRIGHTDATA_WEB_UNLOCKER_TOKEN=
BRIGHTDATA_WEB_UNLOCKER_ZONE=
